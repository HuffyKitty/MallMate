# 可复制为 backend/.env。正式环境必须关闭演示模式和自动种子数据。
MALLMATE_ENVIRONMENT=development
MALLMATE_DEMO_MODE=false
MALLMATE_SEED_DEMO_DATA=true
MALLMATE_DATABASE_URL=sqlite:///./mallmate_dev_v2.db
MALLMATE_DATABASE_ECHO=false
MALLMATE_DATABASE_POOL_SIZE=5
MALLMATE_DATABASE_MAX_OVERFLOW=10
MALLMATE_DATABASE_POOL_TIMEOUT_SECONDS=30
MALLMATE_CORS_ORIGINS=http://localhost:3000

# setup.ps1 会在本机 backend/.env 中生成随机密钥。不要把真实密钥提交到 Git。
MALLMATE_AUTH_ENABLED=true
MALLMATE_JWT_SECRET=
MALLMATE_JWT_ALGORITHM=HS256
MALLMATE_JWT_ISSUER=mallmate-api
MALLMATE_JWT_AUDIENCE=mallmate-web
MALLMATE_ACCESS_TOKEN_MINUTES=15
MALLMATE_REFRESH_TOKEN_DAYS=7
MALLMATE_REFRESH_COOKIE_NAME=mallmate_refresh
MALLMATE_REFRESH_COOKIE_PATH=/api/v1/auth
MALLMATE_COOKIE_SECURE=false
MALLMATE_COOKIE_SAMESITE=lax

# Docker 内部地址由 compose.yaml 覆盖；下面是从本机进程访问容器的默认地址。
MALLMATE_REDIS_URL=redis://localhost:6379/0
MALLMATE_CHROMA_HOST=localhost
MALLMATE_CHROMA_PORT=18000
MALLMATE_CHROMA_COLLECTION=mallmate_knowledge
MALLMATE_MINIO_ENDPOINT=http://localhost:9000
MALLMATE_MINIO_ACCESS_KEY=mallmate
MALLMATE_MINIO_SECRET_KEY=mallmate_dev_only
MALLMATE_MINIO_BUCKET=mallmate-evidence

# 通义千问暂时关闭，只保留配置。请把 YOUR_WORKSPACE_ID 换成实际工作空间 ID。
# API Key 与 Base URL 必须属于同一地域，密钥只写在 backend/.env。
MALLMATE_LLM_ENABLED=false
MALLMATE_LLM_PROVIDER=dashscope
MALLMATE_LLM_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MALLMATE_LLM_CHAT_MODEL=qwen-plus
MALLMATE_LLM_INTENT_MODEL=qwen-flash
MALLMATE_LLM_VISION_MODEL=qwen-vl-plus
MALLMATE_LLM_EMBEDDING_MODEL=text-embedding-v4
MALLMATE_LLM_RERANK_MODEL=qwen3-rerank
MALLMATE_LLM_API_KEY=
MALLMATE_PROMETHEUS_ENABLED=true

